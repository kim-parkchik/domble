{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "domble",
  "version": "0.2.0",
  "identifier": "jp.accounting.domble",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "domble", "width": 1360, "height": 840, "minWidth": 1100, "minHeight": 640, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
